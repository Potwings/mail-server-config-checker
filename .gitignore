# Gradle
.gradle/
build/

# 로컬 전용 설정 (Spamhaus DQS 키 등 비밀값) — .example 템플릿만 커밋
application-local.yml
application-local.properties

# Claude Code 로컬 작업 디렉터리 (worktree 등)
.claude/

# IDE
.idea/
*.iml
out/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle wrapper jar must be committed (exception must come after *.jar to win)
!gradle/wrapper/gradle-wrapper.jar
